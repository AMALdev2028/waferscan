# GPU training image (EfficientNet-B7 / SE-ResNeXt-101 / Swin via timm, MLflow tracking).
#   docker build -f deploy/docker/Dockerfile.train -t waferscan-train .
#   docker run --gpus all -v $PWD/data:/app/data -e MLFLOW_TRACKING_URI=http://mlflow:5000 waferscan-train \
#       --config configs/gpu_full.yaml --backbone swin_t
FROM pytorch/pytorch:2.5.1-cuda12.4-cudnn9-runtime
RUN apt-get update && apt-get install -y --no-install-recommends libglib2.0-0 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY pyproject.toml ./
COPY waferscan ./waferscan
RUN pip install --no-cache-dir ".[train]"
COPY configs ./configs
ENV PYTHONUNBUFFERED=1
ENTRYPOINT ["python", "-m", "waferscan.training.train"]
